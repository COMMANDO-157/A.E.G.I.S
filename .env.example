# Server-only. Do not copy CloudSentry credentials or reuse its database.
DATABASE_URL=
GOOGLE_CLIENT_ID=
APP_ORIGIN=http://localhost:5501
PORT=5501
# Set false only for a trusted local PostgreSQL server. Production defaults to TLS.
DATABASE_SSL=true

# Keep disabled until shared rate limiting and live authorization tests pass.
LIVE_INTAKE_ENABLED=false

# Trusted migration operator only; never put this owner connection in Vercel.
MIGRATION_DATABASE_URL=
# Random secret of at least 32 characters for the scheduled maintenance route.
CRON_SECRET=

# Cloudflare R2 / S3-compatible private evidence storage (Production & Cloud staging)
# Leave unset in local development to use local disk storage (data/evidence/private)
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_REGION=auto
EVIDENCE_STORAGE_ACCESS_KEY_ID=
EVIDENCE_STORAGE_SECRET_ACCESS_KEY=
