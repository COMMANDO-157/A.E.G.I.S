{
  "name": "aegis",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.7"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/local.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "admin:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-admin.js",
    "build": "npm --prefix frontend run build",
    "vercel-build": "npm --prefix frontend install && npm --prefix frontend run build",
    "test:auth": "node --test test_auth.js",
    "test:portals": "node --test test_dual_auth_portals.js",
    "test": "node --test test_auth.js test_dual_auth_portals.js",
    "db:health": "node --env-file-if-exists=.env scripts/health.js",
    "security:cleanup": "node --env-file-if-exists=.env scripts/cleanup.js",
    "test:integration": "node --env-file-if-exists=.env test_integration.js"
  },
  "dependencies": {
    "google-auth-library": "^10.5.0",
    "pg": "^8.23.1"
  }
}
